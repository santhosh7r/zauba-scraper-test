[Unit]
# ─────────────────────────────────────────────────────────────────────────────
#  DO NOT copy this file directly to /etc/systemd/system/ !
#  The paths/user below are placeholders. Run  ./install.sh  instead — it
#  generates a copy with the correct paths and user for THIS machine.
# ─────────────────────────────────────────────────────────────────────────────
Description=Zauba Corp Continuous Scraper (Human-Mode Browser)
After=network-online.target
Wants=network-online.target
# Keep restarting forever, no matter how often it fails.
StartLimitIntervalSec=0

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/path/to/zauba-scraper

# The browser runs headless=False so it looks like a real desktop user. On a
# screenless VPS the bot starts its OWN Xvfb virtual display automatically
# (via pyvirtualdisplay) — no ExecStartPre tricks needed. Just install Xvfb:
#     sudo apt install -y xvfb
ExecStart=/path/to/zauba-scraper/venv/bin/python3 /path/to/zauba-scraper/bot.py

# Restart on any exit (crash, error, or clean) and after a reboot.
Restart=always
RestartSec=30

# Logs go to the systemd journal — read them with:
#     journalctl -u zauba-scraper -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
