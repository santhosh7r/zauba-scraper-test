                phone = countryCode + ' ' + phoneNum;

                try {
                    const res = await fetch('/save-contact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: needsEmail ? email : '',
                            phone: phone,
                        }),
                    });

                    if (!res.ok) {
                        const data = await res.json();
                        $('#ctm-error').text(data.error || 'Something went wrong. Please try again.');
                        btn.disabled = false;
                        return;
