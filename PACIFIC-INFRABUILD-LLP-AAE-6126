    handleRazorpayCheckout = async (response) => {
        if (response.error) {
            handleError(response.error);
        } else {

            var prefill = {};
            var contactEmail = (pendingAtcResponse && pendingAtcResponse._contactEmail) || '';
            var contactPhone = (pendingAtcResponse && pendingAtcResponse._contactPhone) || '';
            if (contactEmail) { prefill.email = contactEmail; }
            if (contactPhone) { prefill.contact = contactPhone.replace(/[\s-]/g, ''); }

            var options = {
                "key": "rzp_live_73sGzE6ckIIn1l",
                "amount": response.amount,
                "currency": response.currency,
                "order_id": response.order_id,
                "receipt": response.cart_id,
                "capture": "1",
                "prefill": prefill,
                "handler": function (response) {
                    console.log(response);
                    
                    sm();
                },
            };

            razorpayInstance = new window.Razorpay(options);

            razorpayInstance.on("payment.failed", async (response) => {
                console.log(response.error.description);
            });

            
            $('#rzpy').modal('hide');

            razorpayInstance.open();
        } 
    }

    var rpBound = false;
    function rp() {
        submitBtn = document.getElementById('ps');
        submitBtn.disabled = false;

        if (rpBound) return;
        rpBound = true;

        submitBtn.addEventListener('click', async (event) => {

            submitBtn.disabled = true;

            var email = (pendingAtcResponse && pendingAtcResponse._contactEmail) || '';

            const res = await fetch("/razorpay-checkout", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    email: email,
                }),
            });

            if (!res.ok) {
                alert("We were not able to proceed to payment. This is generally a temporary issue. Please try again.");
                submitBtn.disabled = false;
                return;
            }

            const data = await res.json();

            handleRazorpayCheckout(data);
        });
    }

    var spBound = false;
    function sp() {

        stripe = Stripe(
            'pk_live_51ItTPbSH4pzE0WbH4e7xXPTsDdcmd99cXeK4EaUIpMeUntaG8WiG0gmnIMm1tcdKHRAeANCmiOJusy7faYO8yK0Q00caRJRQzs',
            {
                betas: ['custom_checkout_beta_5']
            },
        );

        if (total_price == 0 || currency == '') {
            location.reload();
            return;
        }

        const options = {
            mode: 'payment',
            amount: total_price * 100,
            currency: currency,
            paymentMethodCreation: 'manual',
            appearance: {
                layout: {
                    type: 'accordion',
                    defaultCollapsed: false,
                    radios: true,
                    spacedAccordionItems: false
                }
            },
        };

        elements = stripe.elements(options);
        paymentElementOptions = { layout: 'accordion' };

        paymentElement = elements.create('payment', paymentElementOptions);
        paymentElement.mount('#payment-element');

        addressElement = elements.create("address", {
            mode: "billing",
        });
        addressElement.mount("#address-element");

        form = document.getElementById('pfs');
        submitBtn = document.getElementById('p');
        submitBtn.disabled = false;

        if (spBound) return;
        spBound = true;

        handleError = (error_message) => {
            alert(error_message);
            submitBtn.disabled = false;
        }

        handleServerResponse = async (response) => {
            if (response.error) {
                handleError(response.error);
            } else if (response.status === "requires_action") {
                
                const {
                    error,
                    paymentIntent
                } = await stripe.handleNextAction({
                    clientSecret: response.clientSecret
                });

                if (error) {
                    handleError(error.message);
                } else {
                    sm();
                }
            } else {
                sm();
            }
        }

        form.addEventListener('submit', async (event) => {

            event.preventDefault();

            if (submitBtn.disabled) {
                return;
            }

            submitBtn.disabled = true;

            const { error: submitError } = await elements.submit();

            if (submitError) {
                handleError(submitError.message);
                return;
            }

            const { error, confirmationToken } = await stripe.createConfirmationToken({
                elements,
                params: {
                    return_url: 'https://localhost/order/123/complete'
                }
            });

            if (error) {
                handleError(error.message);
                return;
            }

            var email = (pendingAtcResponse && pendingAtcResponse._contactEmail) || '';

            
            const res = await fetch("/stripe-checkout", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    confirmationTokenId: confirmationToken.id,
                    email: email,
                }),
            });

            
            if (!res.ok) {
                alert("We were not able to process your payment. This is generally a temporary issue. Please try again.");
                submitBtn.disabled = false;
                return;
            }

            const data = await res.json();

            handleServerResponse(data);
        });

    }

    var pendingAtcResponse = null;

    function atcr(response) {
        if (response.error) {
            alert("Something went wrong. Please try again.");
            return;
        }

        if (response.Response.li == null) {
            $('#niic').modal('show');
            return;
        }

        pendingAtcResponse = response;

        var needsEmail = !response.Response.he;
        var needsPhone = !response.Response.hp;

        if (needsEmail || needsPhone) {
            if (needsEmail) {
                $('#ctm-email-group').show();
                $('#ctm-email').val('');
            } else {
                $('#ctm-email-group').hide();
            }
            if (needsPhone) {
                $('#ctm-phone-group').show();
                $('#ctm-phone').val('');
            } else {
                $('#ctm-phone-group').hide();
            }
            $('#ctm-error').text('');
            $('#ctm').modal('show');
        } else {
            showPaymentModal(response);
        }
    }

    function showPaymentModal(response) {
        const table = document.createElement('table');
        table.className = "table table-striped";
        table.style = "border-width: 0px;";

        total_price = 0;
        currency = '';
        currency_display = '';

        response.Response.li.forEach((li) => {
            const tr = document.createElement('tr');
            const td1 = document.createElement('td');
            const td2 = document.createElement('td');
            const td3 = document.createElement('td');

            td1.innerHTML = `${li.d}`;
            if (li.cc == 'usd') {
                li.cc = '$';
                currency = 'usd';
                currency_display = '$';
            } else {
                li.cc = '₹';
                currency = 'inr';
                currency_display = '₹';
            }

            td2.innerHTML = `${li.cc} ${li.p}`;

            td3.innerHTML = `<a style="margin:10px;" title="Remove report" class="dfc" data-cin="${li.c}"> <svg class="text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor"> <path d="M256 48a208 208 0 1 1 0 416 208 208 0 1 1 0-416zm0 464A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM175 175c-9.4 9.4-9.4 24.6 0 33.9l47 47-47 47c-9.4 9.4-9.4 24.6 0 33.9s24.6 9.4 33.9 0l47-47 47 47c9.4 9.4 24.6 9.4 33.9 0s9.4-24.6 0-33.9l-47-47 47-47c9.4-9.4 9.4-24.6 0-33.9s-24.6-9.4-33.9 0l-47 47-47-47c-9.4-9.4-24.6-9.4-33.9 0z"></path> </svg> </a>`;

            tr.appendChild(td1);
            tr.appendChild(td2);
            tr.appendChild(td3);

            table.appendChild(tr);

            total_price += li.p;

        });

        if (currency == "inr") {
            const tr_gst = document.createElement('tr');
            const td1_gst = document.createElement('td');
            const td2_gst = document.createElement('td');
            const td3_gst = document.createElement('td');

            td1_gst.innerHTML = `GST`;
            gst = total_price * 0.18;
            
            gst = Math.round(gst * 100) / 100;
            total_price += gst;
            td2_gst.innerHTML = `${gst} (18%)`;
            td3_gst.innerHTML = ``;

            tr_gst.appendChild(td1_gst);
            tr_gst.appendChild(td2_gst);
            tr_gst.appendChild(td3_gst);

            table.appendChild(tr_gst);
        }

        const tr = document.createElement('tr');
        const td1 = document.createElement('td');
        const td2 = document.createElement('td');
        const td3 = document.createElement('td');

        td1.innerHTML = `Total`;
        td2.innerHTML = `${currency_display} ${total_price}`;
        td3.innerHTML = ``;

        tr.appendChild(td1);
        tr.appendChild(td2);
        tr.appendChild(td3);

        table.appendChild(tr);

        var gateway = response.Response.gw || (response.Response.fi ? 'razorpay' : 'stripe');

        if (gateway === 'ccavenue') {
            const licca = document.getElementById('licca');
            licca.innerHTML = '';
            licca.appendChild(table);
            ccaSetup();
            $('#ccavm').modal('show');
        } else if (gateway === 'razorpay_hosted') {
            const lirph = document.getElementById('lirph');
            lirph.innerHTML = '';
            lirph.appendChild(table);
            rphSetup();
            $('#rphm').modal('show');
        } else if (gateway === 'razorpay') {
            
            const script = document.createElement('script');
            script.src = 'https://checkout.razorpay.com/v1/checkout.js';
            script.async = false;
            document.body.appendChild(script);

            script.onload = () => {

                const lir = document.getElementById('lir');
                lir.innerHTML = '';
                lir.appendChild(table);
                rp();
                $('#rzpy').modal('show');
            }
        } else {
            
            const script = document.createElement('script');
            script.src = 'https://js.stripe.com/v3/';
            script.async = false;
            document.body.appendChild(script);

            script.onload = () => {
                const lis = document.getElementById('lis');
                lis.innerHTML = '';
                lis.appendChild(table);
                sp();
                $('#strp').modal('show');
            }
        }
    }

